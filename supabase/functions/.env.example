# Secrets for the edge functions. Locally: copy to supabase/functions/.env
# (used by `supabase functions serve`). Hosted: `supabase secrets set --env-file supabase/functions/.env`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# AWS keys for license-check. IAM user limited to textract:AnalyzeID, textract:AnalyzeDocument and rekognition:CompareFaces.
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_REGION=us-east-2

# Stripe Dashboard → Developers → API keys (use a test key, sk_test_…, until launch)
STRIPE_SECRET_KEY=sk_test_replace_me

# Restricted key that can download the verified selfie (used as the profile photo).
# Stripe Dashboard → Developers → API keys → Create restricted key → turn on
# "Identity verification reports & selfie files: Read" (may need Stripe to enable).
STRIPE_IDENTITY_FILES_KEY=rk_test_replace_me

# Stripe Dashboard → Developers → Webhooks → your identity-webhook endpoint → Signing secret
# Locally: `stripe listen --forward-to http://127.0.0.1:54321/functions/v1/identity-webhook` prints one.
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_replace_me

# The website, for Stripe's "done" redirect
SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Delete the license images and selfie at Stripe right after a successful check
REDACT_AFTER_CHECK=true

# Shared secret the every-minute cron job sends to send-ride-reminders. Any long random string.
CRON_SECRET=replace-with-a-long-random-string

# Optional: Expo access token if you turn on "enhanced push security" in Expo.
EXPO_ACCESS_TOKEN=
