# Local Supabase. On the iOS Simulator 127.0.0.1 works. On a real iPhone
# (Expo Go), use your Mac's Wi-Fi IP instead, e.g. http://192.168.1.20:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-key-from-supabase-start

