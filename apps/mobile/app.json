{
  "expo": {
    "name": "Lift2Lift",
    "slug": "lift2lift",
    "scheme": "lift2lift",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zatzworks.lift2lift",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lift2Lift uses your photos so you can upload your insurance card.",
          "cameraPermission": "Lift2Lift uses the camera so you can snap your insurance card."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "rides"
        }
      ]
    ]
  }
}
