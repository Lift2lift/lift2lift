{
  "expo": {
    "name": "Lift2Lift",
    "slug": "lift2lift",
    "scheme": "lift2lift",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.lift2lift.ios",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lift2Lift uses your photos so you can add your driver's license, a selfie for your verified profile photo, or your insurance card.",
          "cameraPermission": "Lift2Lift uses the camera so you can photograph your driver's license, take the selfie that becomes your verified profile photo, and snap your insurance card.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "rides"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "owner": "lif2lift",
    "extra": {
      "eas": {
        "projectId": "636829ad-1142-46aa-9464-44f90252e715"
      }
    },
    "splash": {
      "backgroundColor": "#15213A"
    }
  }
}
